# Yerel gelistirme icin: bu dosyayi .env.local adiyla kopyalayip doldurun.
# .env.local git'e girmez. Uretimde ayni degiskenler Vercel'in
# Settings > Environment Variables kismina girilir.
#
# NEXT_PUBLIC_TG_BOT bos birakilirsa giris kapisi devre disi kalir ve
# uygulama acik calisir - yerelde normal olan budur, cunku Telegram widget'i
# yalniz BotFather'da /setdomain ile kayitli alan adinda calisir.

# --- tarayiciya giden tek degisken (widget hangi botu gosterecek), @ olmadan
NEXT_PUBLIC_TG_BOT=

# --- sunucuda kalir, hicbiri tarayiciya gitmez
TG_BOT_TOKEN=
TG_LOG_CHAT_ID=
SESSION_SECRET=

# Cekirdek yetkili listesi. Buradakiler bot ile silinemez - kendinizi
# disarida birakmamak icin en az kendi id'nizi yazin.
ALLOWED_USER_IDS=

# Bot komutlarini ve onay tuslarini kullanabilenler.
# Bos birakilirsa ALLOWED_USER_IDS gecerli olur.
TG_ADMIN_IDS=

# Bot webhook'unun gizli basligi. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TG_WEBHOOK_SECRET=

# npm run webhook bunu kullanir (adres komut satirindan da verilebilir).
SITE_URL=

# Bot ile eklenen yetkililer burada saklanir. Vercel > Storage > Upstash Redis
# baglandiginda KV_REST_API_URL / KV_REST_API_TOKEN otomatik gelir.
# Bos birakilirsa uygulama calisir ama bot ile ekleme/silme kapali kalir.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opsiyonel
# SESSION_TTL_HOURS=12
# TG_LOG_THREAD_ID=          # konu (topic) acik gruplarda hedef konu
# TG_API_BASE=               # Telegram'a vekil sunucu uzerinden cikiliyorsa
