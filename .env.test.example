# npm run test:bot icin sahte degerler. Gercek bir bot, kanal ya da Upstash
# hesabi gerekmez - her sey scripts/fake-services.mjs taklidine gider.
#
#   cp .env.test.example .env.local
#   npm run fake            (ayri terminal)
#   npm run dev -- -p 3111  (ayri terminal)
#   npm run test:bot

NEXT_PUBLIC_TG_BOT=testbot
TG_BOT_TOKEN=123456:TEST-TOKEN
TG_LOG_CHAT_ID=-1001234567890
SESSION_SECRET=yerel-test-secret
ALLOWED_USER_IDS=777
TG_ADMIN_IDS=777
TG_WEBHOOK_SECRET=test-webhook-secret
TG_API_BASE=http://localhost:8788
KV_REST_API_URL=http://localhost:8788/kv
KV_REST_API_TOKEN=test-kv-token
